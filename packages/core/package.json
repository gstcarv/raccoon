{
  "name": "raccoon-core",
  "version": "0.1.0",
  "description": "Autonomous coding agent orchestration — core service",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "raccoon": "tsx src/cli.ts"
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "better-sqlite3": "^11.3.0",
    "bullmq": "^5.13.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.36.4",
    "execa": "^9.4.1",
    "express": "^5.0.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.0.0",
    "mongoose": "^9.9.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.8.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
