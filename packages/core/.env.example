# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Public base URL (used to generate webhook callback URLs)
RACCOON_BASE_URL=https://your-raccoon.example.com

# ── Git / Commits ────────────────────────────────────────────────────────────
# Co-author trailer added to every commit raccoon generates
RACCOON_COAUTHOR_NAME=Raccoon Builder
RACCOON_COAUTHOR_EMAIL=builder@raccoon.dev

# ── Workspace ────────────────────────────────────────────────────────────────
# Where raccoon stores bare clones and worktrees (must be writable)
RACCOON_WORKSPACE_DIR=/data/workspaces

# Max runs that can execute in parallel (across all repos)
RACCOON_MAX_CONCURRENT_RUNS=3

# Timeout per run in milliseconds (default: 30 min)
RACCOON_RUN_TIMEOUT_MS=1800000

# Set to true only in an isolated container; adds a warning to boot log
RACCOON_ALLOW_DANGEROUS_PERMISSIONS=false

# Keep worktrees after a failed run for debugging (default: false)
RACCOON_KEEP_FAILED_WORKSPACES=false

# ── Claude Code ──────────────────────────────────────────────────────────────
# OAuth token generated with `claude setup-token` on a Pro/Max/Team/Enterprise account
# This is a high-privilege credential — treat it like a password
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the claude CLI binary (default: 'claude', assumes it's in PATH)
CLAUDE_CODE_PATH=claude

# Optional: override the model used by the agent
# CLAUDE_MODEL=claude-opus-4-8

# ── GitHub ───────────────────────────────────────────────────────────────────
# Option A: Personal Access Token (simpler, limited to one user)
GITHUB_TOKEN=

# Option B: GitHub App (recommended for production — supports token rotation)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# GITHUB_APP_INSTALLATION_ID=

# HMAC secret configured in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=

# GitHub Projects v2 node ID (format: PVT_...) — used as default project
# Can be overridden per-repo in raccoon.config.yaml
GITHUB_PROJECT_ID=

# Name of the single-select status field in your project board
GITHUB_STATUS_FIELD_NAME=Status

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default) — path relative to working directory
DATABASE_URL=file:./data/raccoon.db

# PostgreSQL (optional) — if set, SQLite is not used
# DATABASE_URL=postgresql://user:pass@host:5432/raccoon

# ── Queue (optional) ─────────────────────────────────────────────────────────
# When set, BullMQ + Redis is used instead of the in-memory queue
# REDIS_URL=redis://localhost:6379

# ── MCP Servers (optional) ───────────────────────────────────────────────────
# GitHub MCP server token — separate from GITHUB_TOKEN, can be a read-only PAT
# MCP_GITHUB_TOKEN=
